{
  # Bluetooth battery
  hardware.bluetooth = {
    enable = true;
    settings.General.Experimental = true;
  };

  services.printing.enable = true;

  # Sound with pipewire
  services.pulseaudio.enable = false;
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa = {
      enable = true;
      support32Bit = true;
    };
    pulse.enable = true;
  };
}
